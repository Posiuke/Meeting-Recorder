# Vorlage fuer die lokale .env - kopieren und ausfuellen:
#   cp .env.example .env
# Die .env liegt NICHT in Git (siehe .gitignore) und haelt alle Secrets.

# --- Stack-Secrets (docker-compose.yml) ---
# Datenbank-Passwort (wird fuer Postgres UND die App verwendet).
DB_PASSWORD=bitte-ein-sicheres-passwort-eintragen
# JWT-Signaturschluessel fuer Login-Sessions, min. 32 zufaellige Zeichen.
# Vorschlag zum Erzeugen:  openssl rand -base64 48
JWT_SECRET=bitte-einen-langen-zufaelligen-wert-eintragen
# Lokales Admin-Konto fuer den ersten Login (Passwort muss danach geaendert werden).
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=bitte-aendern

# --- Docker-Push (scripts/docker-push.sh) ---
# Docker-Hub-Benutzer bzw. Organisation (Pflicht fuer den Push)
DOCKER_NAMESPACE=mein-dockerhub-benutzer
# Optional: andere Registry statt Docker Hub, z.B. registry.example.com
DOCKER_REGISTRY=
# Optional: automatischer Login. Empfehlung: stattdessen einmalig `docker login`
# ausfuehren und diese beiden Zeilen leer lassen (Token liegt sonst im Klartext).
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=
